#pragma once

// Copy this file to secrets.h (git-ignored) and fill in your values.
// The ESP32 only supports 2.4 GHz WiFi, and must be on the same network as the backend.

#define WIFI_SSID "your-wifi-name"
#define WIFI_PASSWORD "your-wifi-password"

// Laptop's LAN IPv4 (run `ipconfig`), NOT localhost. Backend default port is 3000.
#define API_BASE_URL "http://192.168.1.50:3000"

// Must equal DEVICE_API_KEY in Backend-hono/.env
#define DEVICE_API_KEY "change-me"

#define DEVICE_ID "front_gate"
